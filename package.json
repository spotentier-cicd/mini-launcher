{
  "name": "mini-launcher",
  "version": "1.0.0",
  "description": "Tableau de bord local pour lancer et ouvrir tes petits projets Express/Hono/etc.",
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "build": "tsc -p src/tsconfig.json",
    "build:watch": "tsc -p src/tsconfig.json --watch",
    "prestart": "npm run build",
    "start": "node server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
