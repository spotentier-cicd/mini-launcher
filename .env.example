# Port du dashboard lui-même
PORT=7777

# Interface d'écoute. 127.0.0.1 = accessible uniquement depuis cette machine.
# Toute autre valeur expose un outil qui exécute des commandes : le serveur
# refuse alors de démarrer sans DASHBOARD_PASSWORD.
BIND_HOST=127.0.0.1

# Dossier parent contenant les projets à détecter
ROOT_DIR=../

# Profondeur de scan des sous-dossiers
SCAN_DEPTH=2

# Mot de passe d'accès au dashboard.
# Laisser vide désactive complètement l'authentification.
DASHBOARD_PASSWORD=
